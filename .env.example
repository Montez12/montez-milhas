# Next.js public read access (Supabase anon/publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker only — configure as GitHub Actions repository secrets.
# Never expose the service role key in NEXT_PUBLIC_* variables or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
